# Workspace the agent may read/write (defaults to the folder you launch Helix from)
HELIX_WORKSPACE=.

# Prefer local models via Ollama (OpenAI-compatible). Example: ollama pull llama3.2
HELIX_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# Or use cloud providers (set HELIX_PROVIDER=openai | anthropic)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: GitHub PAT (repo scope) for commit/push — also connectable in the IDE GitHub tab
# GITHUB_TOKEN=

HELIX_PORT=8787
