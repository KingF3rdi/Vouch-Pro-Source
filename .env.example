# Workspace the agent may read/write (defaults to the folder you launch Helix from)
HELIX_WORKSPACE=.

# Helix Free / local (default without paid keys)
HELIX_MODEL=helix-free
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
HELIX_LOCAL_MODEL=qwen2.5-coder:3b
# Optional free cloud tiers (signup yourself — never share stolen keys):
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# Frontier Helix models (Code / Astra / Fable) via Vercel AI Gateway
# AI_GATEWAY_API_KEY=
# Or use provider keys as fallback:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Unlimited agent budget (recommended)
# 0 = no soft limit — use full model output + keep tool-calling until done
HELIX_MAX_TOKENS=0
HELIX_MAX_STEPS=0
# Absolute safety ceiling only (prevents infinite loops)
HELIX_HARD_STEP_CAP=1000
# 0 = read full files in tools (no truncation)
HELIX_TOOL_READ_MAX_CHARS=0
HELIX_TEMPERATURE=0.2

# Optional: GitHub PAT (repo scope) for commit/push — also connectable in the IDE GitHub tab
# GITHUB_TOKEN=

# Helix agent runtimes
# Primary chat uses TypeScript agents (src/server on HELIX_PORT).
# Optional Python agents: npm run dev:python (HELIX_PYTHON_PORT=8788)
HELIX_PORT=8787
HELIX_PYTHON_PORT=8788
# HELIX_ENABLE_PYTHON_AGENTS=1

# Unlimited agent budget
HELIX_MAX_TOKENS=0
HELIX_MAX_STEPS=0
HELIX_HARD_STEP_CAP=1000
HELIX_TOOL_READ_MAX_CHARS=0
HELIX_TEMPERATURE=0.2
