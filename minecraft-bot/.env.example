# Minecraft-Server
MC_HOST=dein-server.de
MC_PORT=25565

# Echter Minecraft-Account des Bots (Premium)
MC_BOT_USERNAME=DeinBotAccount
# microsoft = Premium/Launcher | offline = nur Cracked-Server
MC_AUTH=microsoft

# Whisper-Befehl auf deinem Server (Essentials: msg, manche Server: tell oder w)
MC_MSG_CMD=msg

# Shop-API
SHOP_API_URL=https://shop.deinedomain.de
BOT_API_KEY=gleicher-key-wie-backend

# Zahlungsempfänger (Shop-Owner IGN, nicht der Bot-Account)
SHOP_OWNER_IGN=DeinShopOwnerIGN
