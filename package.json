{
  "name": "helix-agent",
  "version": "0.3.0",
  "private": true,
  "description": "Local coding AI IDE with Cursor/Claude-style agent, MCP, diffs, and GitHub",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:all": "concurrently -k \"npm:dev:server\" \"npm:dev:python\" \"npm:dev:ui\"",
    "dev:server": "HELIX_WORKSPACE=. HELIX_PORT=8787 HELIX_MAX_STEPS=0 HELIX_MAX_TOKENS=0 tsx src/server/index.ts",
    "dev:backend": "npm run dev:python",
    "dev:python": "cd backend && HELIX_WORKSPACE=.. HELIX_PORT=8788 python3 -m uvicorn main:app --reload --host 127.0.0.1 --port 8788",
    "dev:ui": "vite",
    "desktop": "concurrently -k \"npm:dev:ui\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:electron": "npm run desktop",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "vite build",
    "build": "npm run build:server && npm run build:ui",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "backend:install": "python3 -m pip install -r backend/requirements.txt",
    "setup:free": "bash scripts/setup-free-models.sh",
    "train:own": "bash scripts/setup-free-models.sh",
    "train:weights": "python3 training/train_lora.py",
    "serve:ft": "python3 training/serve_ft.py",
    "start": "bash scripts/start-helix.sh",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "dev.helix.agent",
    "productName": "Helix",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "skills/**/*",
      "plugins/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "dist/**/*",
      "skills/**/*",
      "plugins/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.17",
    "@ai-sdk/gateway": "^4.0.87",
    "@ai-sdk/openai": "^2.0.32",
    "@ai-sdk/react": "^2.0.48",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@monaco-editor/react": "^4.7.0",
    "ai": "^5.0.48",
    "cors": "^2.8.5",
    "diff": "^8.0.2",
    "express": "^5.1.0",
    "glob": "^11.0.3",
    "lucide-react": "^0.544.0",
    "playwright": "^1.55.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.20.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4"
  }
}
